# Copy this file to agent.env and fill it in. agent.env stays on your PC (it's in .gitignore).

# Your Lovable app's database (already filled — same values as the project's .env)
SUPABASE_URL=https://vnxjckhfmwgndvhwmooi.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZueGpja2hmbXdnbmR2aHdtb29pIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE5NzU3MjAsImV4cCI6MjA5NzU1MTcyMH0.jlZyRfrhbc-zOVcXJaCLT-7rzJ_Imyqt2x1kW7KMXzU

# A separate team account for the agent: sign up on your site with this email + password
AGENT_EMAIL=
AGENT_PASSWORD=

# Telegram: talk to @BotFather → /newbot → paste the token here
TELEGRAM_TOKEN=

# Gmail: myaccount.google.com → Security → 2-Step Verification on → App passwords → create one
GMAIL_USER=ahmad000haddad@gmail.com
GMAIL_APP_PASSWORD=
SENDER_NAME=Ahmad Haddad

# Sending limit per day: starts at DAILY_CAP, +RAMP_STEP every RAMP_DAYS sending days, up to DAILY_MAX, only while bounces stay low
DAILY_CAP=20
DAILY_MAX=40
RAMP_STEP=5
RAMP_DAYS=3
REPORT_HOUR=8

# Extra links the safety check allows (besides your portfolio)
ALLOWED_LINKS=ahmadhaddad.lovable.app,faiihouse.lovable.app,behance.net/ahmad00haddad,behance.com/ahmad00haddad

# Analyse new leads on this PC with Ollama (free). 1 = on, 0 = off
LOCAL_ANALYSIS=1
OLLAMA_MODEL=qwen2.5:14b
WRITE_MODEL=gemma3:12b

# NVIDIA hosted models (free tier, build.nvidia.com). Leave empty to use only Ollama; Ollama is the automatic fallback.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Sending pace: emails leave ONE at a time, GAP_MIN–GAP_MAX random minutes apart, in SEND_HOURS (PC time) and never on OFF_DAYS
# (Monday=0 … Friday=4, Saturday=5). Urgent ones go at once: ⚡ pressed, an opportunity closing within RUSH_DAYS, or a reply
# to someone who answered; they may exceed the day's limit by RUSH_EXTRA.
GAP_MIN=8
GAP_MAX=20
SEND_HOURS=9-17
OFF_DAYS=4,5
RUSH_DAYS=7
RUSH_EXTRA=5
